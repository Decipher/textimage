/**
 * Textimage functions.
 */

/**
 * Prepares variables to get a Textimage.
 *
 * Default template: textimage-formatter.html.twig.
 */
function template_preprocess_textimage_formatter(&$variables) {
  $output = array();

  // Get URI to image file.
  if ($variables['textimage'] && $variables['textimage'] instanceof Textimage) {
    $image_uri = $variables['textimage']->getUri();
  }
  else {
    $textimage = \Drupal::service('textimage.factory')->getTextimage();

    if ($variables['style_name']) {
      $textimage->styleByName($variables['style_name']);
    }
    else  {
      $textimage->effects($variables['effects']);
    }

    if ($variables['source_image_file']) {
      $textimage->sourceImageFile($variables['source_image_file']);
    }
    if ($variables['node']) {
      $textimage->node($variables['node']);
    }

    if ($variables['target_uri']) {
      $textimage->setTargetUri($variables['target_uri']);
    }
    else {
      $textimage->setCaching($variables['caching']);
    }

    if ($variables['force_hashed_filename']) {
      $textimage->setHashedFilename(TRUE);
    }

    $textimage->extension($variables['extension']);
    $textimage->process($variables['text']);
    $image_uri = $textimage->getUri();
  }

  // Render through image theme.
  if ($image_uri) {
    $image = \Drupal::service('image.factory')->get($image_uri);
    $title = \Drupal::service('textimage.factory')->processTextString($variables['title'], NULL, $variables['node'], $variables['source_image_file']);
    $url = file_create_url($image_uri);

    // Build anchor link data if needed.
    if ($variables['href']) {
      $variables['anchor_attributes'] = new Attribute([
        'title' => $title,
        'href' => ($variables['href'] == '#textimage_derivative_url#') ? $url : $variables['href'],
      ]);
    }
    // Replace occurrences of #textimage_derivative_url# with the actual URL
    // in the image container attributes.
    if (!empty($variables['image_container_attributes'])) {
      foreach ($variables['image_container_attributes'] as &$attribute) {
        foreach ($attribute as $key => $value) {
          $attribute[$key] = str_replace('#textimage_derivative_url#', $url, $value);
        }
      }
      $variables['image_container_attributes'] = new Attribute($variables['image_container_attributes']);
    }
    // Get the <img>.
    $variables['image'] = array(
      '#theme' => 'image__textimage',
      '#uri' => $image_uri,
      '#width' => $image->getWidth(),
      '#height' => $image->getHeight(),
      '#alt' => \Drupal::service('textimage.factory')->processTextString($variables['alt'], NULL, $variables['node'], $variables['source_image_file']),
      '#title' => $title,
      '#attributes' => $variables['attributes'],
    );
  }
}

/**
 * Prepares variables to get a color info.
 *
 * Default template: textimage-color-detail.html.twig.
 */
function template_preprocess_textimage_color_detail(&$variables) {
  $variables['#attached']['library'][] = 'textimage/admin.ui';
  if ($variables['color']) {
    if ($variables['border']) {
      if ($variables['border_color'] == 'matchLuma') {
        $variables['border_color'] = ColorUtility::matchLuma($variables['color']);
      }
      else {
        $variables['border_color'] = Unicode::substr($variables['border_color'], 0, 7);
      }
    }
    $variables['color_opacity'] = ColorUtility::rgbaToOpacity($variables['color']);
    $variables['color'] = Unicode::substr($variables['color'], 0, 7);
  }
}

/**
 * Display/log a diagnostic message.
 *
 * @param string $message
 *   message
 * @param int $severity
 *   severity as per watchdog()
 * @param string $caller
 *   the calling function
 */
function _textimage_diag($message, $severity, $caller = NULL, $user_messages = TRUE) {
  if ($caller) {
    $message = t("@message - Function: @caller", array('@message' => $message, '@caller' => $caller));
  }
  if (in_array($severity, ['notice', 'warning', 'error'])) {
    \Drupal::logger('textimage')->$severity($message);
  }
  if ($severity <= \Drupal::config('textimage.settings')->get('message_level') && $user_messages) {
    switch ($severity) {
      case 'debug':
      case 'info':
      case 'notice':
        $type = 'status';
        break;

      case 'warning':
        $type = 'warning';
        break;

      default:
        $type = 'error';
    }
    drupal_set_message($message, $type, FALSE);
  }
}

/**
 * Helper - check if a module is enabled and at a specified release level.
 *
 * @param string $module
 *   Module name.
 * @param string $version
 *   (optional) Module version.
 * @param string $comparison_operator
 *   (optional) A comparison operator to test against $version.
 *
 * @return bool
 *   TRUE if module is enabled, FALSE otherwise.
 */
function _textimage_module_exists($module, $version = NULL, $comparison_operator = '>=') {
  if (!module_exists($module)) {
    return FALSE;
  }
  if ($version) {
    $module_info = system_get_info('module', $module);
    if (empty($module_info['version'])) {
      return TRUE;
    }
    return version_compare($module_info['version'], $version, $comparison_operator);
  }
  return TRUE;
}
