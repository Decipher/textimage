    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Stuart Clark",
            "homepage": "https://www.drupal.org/u/deciphered",
            "role": "Creator & Maintainer"
        }
    ],
    "homepage": "https://www.drupal.org/project/textimage",
    "support": {
        "issues": "https://www.drupal.org/project/issues/textimage",
        "source": "https://git.drupalcode.org/project/textimage"
