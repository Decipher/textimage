<?php

/**
 * @file
 * Textimage - Installation scripts.
 */

use Drupal\Core\StreamWrapper\StreamWrapperInterface;

/**
 * Implements hook_requirements().
 */
function textimage_requirements($phase) {
  $requirements = array();

  // Check PHP GD2 library enabled and providing FreeType support.
  if (function_exists('imagegd2')) {
    $info = gd_info();
    // Check for FreeType support.
    if (!function_exists('imagettftext') || !isset($info["FreeType Support"])) {
      // No FreeType support, raise error.
      $requirements['textimage_gd'] = array(
        'title' => t('GD library FreeType support'),
        'value' => $info['GD Version'],
        'severity' => REQUIREMENT_ERROR,
        'description' => t('The GD Library for PHP is enabled, but was compiled without FreeType support. It was probably compiled using the official GD libraries from http://www.libgd.org instead of the GD library bundled with PHP. You should recompile PHP --with-gd using the bundled GD library. See <a href="http://www.php.net/manual/book.image.php">the PHP manual</a>.'),
      );
    }
  }
  else {
    // No GD2, raise error.
    $requirements['textimage_gd'] = array(
      'title' => t('GD library'),
      'value' => t('Not installed'),
      'severity' => REQUIREMENT_ERROR,
      'description' => t('The GD library for PHP is missing or outdated.'),
    );
  }

  return $requirements;
}

/**
 * Implements hook_schema().
 */
function textimage_schema() {
  $schema = array();

  // Define {textimage_store}.
  $schema['textimage_store'] = array(
    'description' => 'Metadata for stored Textimage images.',
    'fields' => array(
      'tiid' => array(
        'description' => 'Primary key; SHA256 hash of effects and image variables.',
        'type' => 'varchar',
        'length'   => 64,
        'not null' => TRUE,
      ),
      'is_void' => array(
        'description' => 'True if referenced file has been deleted.',
        'type' => 'int',
        'size' => 'tiny',
        'default' => 0,
        'not null' => TRUE,
      ),
      'style_name' => array(
        'description' => 'Image style name.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
      ),
      'uri' => array(
        'description' => 'Image URI.',
        'type' => 'text',
        'not null' => TRUE,
      ),
      'effects_outline'    => array(
        'type' => 'blob',
        'not null' => TRUE,
        'serialize' => TRUE,
        'description' => 'Effects metadata.',
      ),
      'image_data'    => array(
        'type' => 'blob',
        'not null' => TRUE,
        'serialize' => TRUE,
        'description' => 'Image data.',
      ),
      'timer' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Time in milliseconds that the image took to build.',
      ),
      'timestamp' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Timestamp of when the image was built.',
      ),
    ),
    'primary key' => array('tiid'),
  );

  return $schema;
}

/**
 * Implements hook_install().
 */
function textimage_install() {

  $config = \Drupal::config('textimage.settings');

  // Find out scheme to use for the textimage_store directory. Preference to
  // 'private'.
  $scheme = 'private';
  if ($private_wrapper = \Drupal::service('stream_wrapper_manager')->getViaScheme($scheme)) {
    $private_directory = $private_wrapper->getDirectoryPath();
  }
  if (!$private_wrapper || !isset($private_directory) || !file_prepare_directory($private_directory, FILE_CREATE_DIRECTORY)) {
    $scheme = 'public';
    _textimage_diag(
      t(
        'Textimage created its repository of images and fonts in the <b>public</b> file storage. It is recommended to use the <b>private</b> file storage for this, but it is not set up correctly. You can specify the "Private file system path" visiting the <a href="@url">File system</a> configuration page, then change the set up in the <a href="@url1">Textimage settings</a>.',
        array(
          '@url' => \Drupal::url('system.file_system_settings'),
          '@url1' => \Drupal::url('textimage.settings'),
        )
      ),
      'warning'
    );
  }

  // Set store scheme in config.
  $store_scheme = $config->get('store_scheme');
  $store_scheme = str_replace('[scheme]', $scheme, $store_scheme);
  $config->set('store_scheme', $store_scheme);

  // Create fonts directory.
  $fonts_path = $config->get('font.plugin_settings.textimage.path');
  $fonts_path = str_replace('[scheme]', $scheme, $fonts_path);
  if (!file_prepare_directory($fonts_path, FILE_CREATE_DIRECTORY)) {
    _textimage_diag(
      t(
        'Failed to create directory "%path". Visit the <a href="@url">configuration page</a> to setup font management.',
        array(
          '%path' => $fonts_path,
          '@url' => \Drupal::url('textimage.settings'),
        )
      ),
      'error'
    );
  }
  $config->set('font.plugin_settings.textimage.path', $fonts_path);

  // Create backgrounds directory.
  $backgrounds_path = $config->get('background.plugin_settings.textimage.path');
  $backgrounds_path = str_replace('[scheme]', $scheme, $backgrounds_path);
  if (!file_prepare_directory($backgrounds_path, FILE_CREATE_DIRECTORY)) {
    _textimage_diag(
      t(
        'Failed to create directory "%path". Visit the <a href="@url">configuration page</a> to setup background images management.',
        array(
          '%path' => $backgrounds_path,
          '@url' => \Drupal::url('textimage.settings'),
        )
      ),
      'error'
    );
  }
  $config->set('background.plugin_settings.textimage.path', $backgrounds_path);

  $config->save();
}

/**
 * Implements hook_uninstall().
 */
function textimage_uninstall() {
  // Delete the textimage directory from each registered wrapper.
  $wrappers = \Drupal::service('stream_wrapper_manager')->getWrappers(StreamWrapperInterface::WRITE_VISIBLE);
  foreach ($wrappers as $wrapper => $wrapper_data) {
    if (file_exists($directory = $wrapper . '://textimage')) {
      file_unmanaged_delete_recursive($directory);
    }
  }
}
